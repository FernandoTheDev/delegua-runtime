#!/bin/sh
set -e

CC=${CC:-clang}
SRC="src/delegua_rt.c"
TARGET="o"

if ! command -v "$CC" >/dev/null 2>&1; then
    echo "Erro: Compilador '$CC' não encontrado." >&2
    echo "Instale o clang ou defina a variável de ambiente CC." >&2
    exit 1
fi

if ! command -v pkg-config >/dev/null 2>&1; then
    echo "Erro: 'pkg-config' não encontrado. É necessário para achar as bibliotecas." >&2
    exit 1
fi

if ! pkg-config --exists bdw-gc; then
    echo "Erro: Biblioteca 'bdw-gc' (Boehm GC) não encontrada pelo pkg-config." >&2
    echo "Dica de instalação:" >&2
    echo "  Ubuntu/Debian: sudo apt install libgc-dev" >&2
    echo "  Arch Linux:    sudo pacman -S gc" >&2
    exit 1
fi

while [ "$#" -gt 0 ]; do
    case "$1" in
        -ll) TARGET="ll" ;;
        -s)  TARGET="s"  ;;
        -o)  TARGET="o"  ;;
        *) echo "Flag desconhecida: $1. Use -ll, -s ou -o" >&2; exit 1 ;;
    esac
    shift
done

CFLAGS="-std=c99 -Wall -Wextra -Werror -pedantic -Wconversion -Wshadow -fPIC -g ${CFLAGS:-} $(pkg-config --cflags bdw-gc)"
mkdir -p .build
for SRC in src/*.c; do
    NAME=$(basename "$SRC" .c)
    case "$TARGET" in
        o) "$CC" $CFLAGS -c "$SRC" -o ".build/$NAME.o" ;;
        ll) "$CC" $CFLAGS -S -emit-llvm "$SRC" -o ".build/$NAME.ll" ;;
        s) "$CC" $CFLAGS -S "$SRC" -o ".build/$NAME.s" ;;
    esac
done
if [ "$TARGET" = o ]; then
    "$CC" -r .build/*.o -o libdelegua_rt.o
    echo "OK -> libdelegua_rt.o"
else
    echo "OK -> .build/*.$TARGET (um arquivo por módulo)"
fi
